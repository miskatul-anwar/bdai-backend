# Supabase & PostgreSQL Database URL
# For local Supabase CLI:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# For Supabase Cloud project, use your project's connection pooler string:
# DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase API details
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server settings
PORT=8080
RUST_LOG=info,bdai_backend=debug

# Security & JWT
JWT_SECRET=super_secret_bdai_jwt_key_2026_change_in_production
JWT_EXPIRATION_HOURS=72

# Rate Limiting (Token Bucket per Client IP)
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=50

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=bdai_preset
CLOUDINARY_FOLDER=bdai

# Google OAuth 2.0 Credentials
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
FRONTEND_URL=http://localhost:3001

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://bdai.bike-csecu.com

